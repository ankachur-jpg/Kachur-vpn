<resources>
    <style name="Theme.Kachur" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/ui_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/ui_light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/ui_light_bars</item>
        <item name="android:colorAccent">@color/ui_accent</item>
        <item name="android:textColorPrimary">@color/ui_text</item>
        <item name="android:textColorSecondary">@color/ui_muted</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="Theme.Kachur.QuickConnect" parent="Theme.Kachur">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@color/ui_surface</item>
        <item name="android:windowMinWidthMajor">58%</item>
        <item name="android:windowMinWidthMinor">86%</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>
</resources>
